<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ person.name }} — Résumé</title>{# becomes the PDF's Title #}
<style>
  /* Static Archivo instances (OFL; scripts/make_resume_fonts.py): body 400/100%,
     display 740/75%, label 600/80%. Styles below must use exactly these pairs.
     Static fonts keep real spaces in the PDF text layer; the site's variable
     font would be embedded as Type 3 outlines without them. */
  {% for face in fonts %}
  @font-face {
    font-family: "Archivo";
    src: url("{{ face.url }}") format("truetype");
    font-weight: {{ face.weight }};
    font-stretch: {{ face.width }}%;
    font-style: normal;
    font-display: block;
  }
  {% endfor %}

  @page {
    size: Letter;
    margin: 0.45in 0.55in 0.4in;
  }

  :root {
    --ink:    #0a1a33;
    --ink-2:  #3d4d6a;
    --blue:   #113c8a;
    --rule:   #c9d3e2;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    font-size: 9.25pt;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  body {
    margin: 0;
    background: #fff;
    color: var(--ink);
    font-family: "Archivo", "Helvetica Neue", Arial, sans-serif;
    font-weight: 400;
    font-stretch: 100%;
    font-synthesis: none;               /* never fake a weight that has no file */
    line-height: 1.25;
    font-kerning: normal;
    text-rendering: optimizeLegibility;
    zoom: {{ fit }};                    /* < 1 only when resume_pdf.py must shrink to fit */
  }

  h1, h2, h3, h4, p, ul, dl, dd { margin: 0; padding: 0; font-size: inherit; }
  ul { list-style: none; }
  a { color: inherit; text-decoration: none; }
  .nobr { white-space: nowrap; }

  .display { font-stretch: 75%; font-weight: 740; }
  .label   { font-stretch: 80%; font-weight: 600; }
  .display, .label { word-spacing: 0.1em; }   /* condensed spaces are narrow; ≥ ~0.21em keeps */
                                             /* them as spaces in geometric text extraction  */

  /* Header -------------------------------------------------------------- */
  .masthead {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18pt;
  }
  .name {
    font-size: 27pt;
    line-height: 1;
    color: var(--blue);
  }
  .title {
    margin-top: 3pt;
    font-size: 11pt;
    line-height: 1.2;
  }
  .contact {
    font-size: 9pt;
    line-height: 1.3;
    text-align: right;
    color: var(--ink-2);
  }
  a.link {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 0.6pt;
    text-underline-offset: 1.5pt;
  }
  .summary {
    font-size: 9.75pt;
    line-height: 1.32;
    text-wrap: pretty;
  }

  /* Sections ------------------------------------------------------------ */
  .section { margin-top: 7.5pt; }
  .section > h2 {
    display: flex;
    align-items: center;
    gap: 7pt;
    margin-bottom: 3pt;
    font-size: 11.5pt;
    line-height: 1;
    color: var(--blue);
  }
  .section > h2::after {
    content: "";
    flex: 1;
    border-top: 0.75pt solid var(--blue);
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12pt;
  }
  .dates {
    flex: none;
    white-space: nowrap;
    font-size: 9pt;
    color: var(--ink-2);
  }
  .sub {                               /* secondary detail, body instance */
    margin-left: 2pt;
    font-size: 9.25pt;
    font-weight: 400;
    font-stretch: 100%;
    word-spacing: normal;
    color: var(--ink-2);
  }
  .sep { font-weight: 400; font-stretch: 100%; word-spacing: normal; color: var(--ink-2); }

  /* Experience ---------------------------------------------------------- */
  .org + .org { margin-top: 6pt; }
  .org-name { font-size: 10.5pt; }
  .role { margin-top: 2.5pt; }
  .role-title, .role-inline { font-size: 9.75pt; }
  .arrow { font-weight: 400; font-stretch: 100%; word-spacing: normal; color: var(--ink-2); }
  .bullets { margin-top: 1pt; }
  .bullets li {
    padding-left: 10pt;
    text-indent: -10pt;                 /* the marker hangs in the padding */
    text-wrap: pretty;
  }
  .bullets li + li { margin-top: 1pt; }
  .bullets li::before {                 /* in-flow (not positioned), so the PDF */
    content: "";                        /* content stream keeps reading order  */
    display: inline-block;
    width: 2.8pt;
    height: 2.8pt;
    margin: 0 6.2pt 0 1pt;
    vertical-align: middle;
    background: var(--blue);
  }

  /* Ventures ------------------------------------------------------------ */
  .venture + .venture { margin-top: 3pt; }
  .venture p { text-wrap: pretty; }
  .venture-name { font-size: 10pt; }

  /* Skills -------------------------------------------------------------- */
  .skills {
    display: grid;
    grid-template-columns: max-content 1fr;
    align-items: baseline;
    column-gap: 12pt;
    row-gap: 1pt;
  }
  .skills dt { font-size: 9.25pt; }
  .skills dd { text-wrap: pretty; }

  /* Education ----------------------------------------------------------- */
  .edu + .edu { margin-top: 2.5pt; }
  .edu-degree { font-size: 9.75pt; }
</style>
</head>
<body>
{% set arrow %} <span class="arrow">→</span> {% endset %}
<header class="masthead">
  <div>
    <h1 class="name display">{{ person.name }}</h1>
    <p class="title label">{{ person.title|typeset }}</p>
  </div>
  <ul class="contact">
    <li>{{ person.location }}</li>
    <li><a class="link" href="tel:{{ person.phone_href }}">{{ person.phone }}</a></li>
    <li><a class="link" href="mailto:{{ person.email }}">{{ person.email }}</a></li>
    <li><a class="link" href="{{ person.linkedin }}">{{ person.linkedin_display }}</a></li>
  </ul>
</header>
<main>
  {% if summary %}
  <section class="section" aria-labelledby="summary">
    <h2 id="summary" class="display">Professional Summary</h2>
    <p class="summary">{{ summary|typeset }}</p>
  </section>
  {% endif %}
  <section class="section" aria-labelledby="experience">
    <h2 id="experience" class="display">Experience</h2>
    {% for org in groups %}
    {% set single = org.roles|length == 1 %}
    <article class="org">
      {# One role: it rides on the company line. Several: each gets its own line. #}
      <div class="row">
        <h3 class="org-name display">{{ org.name }}{% if org.detail %} <span class="sub">{{ org.detail }}</span>{% endif %}{% if single %} <span class="sep">·</span> <span class="role-inline label">{{ org.roles[0].title_parts|join(arrow) }}</span>{% endif %}</h3>
        <span class="dates">{{ org.period|typeset }}</span>
      </div>
      {% for role in org.roles %}
      <div class="role">
        {% if not single %}
        <div class="row">
          <h4 class="role-title label">{{ role.title_parts|join(arrow) }}</h4>
          <span class="dates">{{ role.period|typeset }}</span>
        </div>
        {% endif %}
        {% if role.bullets %}
        <ul class="bullets">
          {% for bullet in role.bullets %}
          <li>{{ bullet|typeset }}</li>
          {% endfor %}
        </ul>
        {% endif %}
      </div>
      {% endfor %}
    </article>
    {% endfor %}
  </section>

  {% if ventures %}
  <section class="section" aria-labelledby="ventures">
    <h2 id="ventures" class="display">Ventures</h2>
    {% for venture in ventures %}
    <div class="venture row">
      <p><strong class="venture-name display">{{ venture.name }}</strong>{% if venture.role %} <span class="sub">{{ venture.role }}</span>{% endif %} <span class="sep">—</span> {{ venture.summary|typeset }}{% if venture.url %} <a class="link" href="{{ venture.url }}">{{ venture.url_display }}</a>{% endif %}</p>
      {% if venture.period %}
      <span class="dates">{{ venture.period|typeset }}</span>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section class="section" aria-labelledby="skills">
    <h2 id="skills" class="display">Skills</h2>
    <dl class="skills">
      {% for group in skills %}
      <dt class="label">{{ group.category }}</dt>
      <dd>{% for name in group.names %}<span class="nobr">{{ name }}</span>{{ ", " if not loop.last }}{% endfor %}</dd>
      {% endfor %}
    </dl>
  </section>

  <section class="section" aria-labelledby="education">
    <h2 id="education" class="display">Education</h2>
    {% for item in education %}
    <div class="edu">
      <div class="row">
        <h3 class="edu-degree label">{{ item.degree }} <span class="sub">{{ item.school }}</span></h3>
        {% if item.dates %}
        <span class="dates">{{ item.dates|typeset }}</span>
        {% endif %}
      </div>
      {% if item.note %}
      <ul class="bullets">
        <li>{{ item.note|typeset }}</li>
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
</main>
</body>
</html>

<!DOCTYPE html>
{# Link-preview images, screenshotted by scripts/share_card.py.
   mode "card": the 1200×630 og:image, drawn like the site masthead.
   mode "icon": the 180×180 apple-touch-icon (iOS rounds the corners itself). #}
<html lang="en">
<head>
<meta charset="UTF-8" />
<style>
  @font-face {
    font-family: "Archivo";
    src: url("{{ font_url }}") format("woff2");
    font-weight: 100 900;
    font-stretch: 62% 125%;
  }
  html, body { margin: 0; overflow: hidden; }
  body { font-family: "Archivo", "Helvetica Neue", Arial, sans-serif; color: #fff; background: #0f2550; }
  .display { font-weight: 740; font-stretch: 75%; line-height: 0.95; }

  .masthead {
    position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden;
    background: linear-gradient(180deg, #0f2550 0%, #0a1a3a 100%);
  }
  .masthead__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

  .card { position: absolute; left: 84px; top: 0; bottom: 0; width: 760px; display: flex; flex-direction: column; justify-content: center; }
  .avatar {
    width: 156px; height: 156px; border-radius: 50%; object-fit: cover;
    box-shadow: 0 0 0 5px #0f2550, 0 0 0 7px rgba(143, 220, 255, 0.55);
  }
  .name { margin: 30px 0 0; font-size: 108px; letter-spacing: -0.01em; }
  .role { margin: 16px 0 0; font-size: 44px; font-weight: 600; font-stretch: 88%; }
  .focus { margin: 8px 0 0; font-size: 30px; color: #dde8fb; }
  .sections {
    position: absolute; left: 84px; bottom: 46px; margin: 0;
    font-size: 22px; font-weight: 600; font-stretch: 88%; letter-spacing: 0.04em; color: #8fdcff;
  }

  .icon { display: block; width: {{ width }}px; height: {{ height }}px; }
</style>
</head>
<body>
{% if mode == "icon" %}
<svg class="icon" viewBox="0 0 64 64" aria-hidden="true">
  <rect width="64" height="64" fill="#0f2550"/>
  <path d="M13 17h38v30H13z" fill="none" stroke="#fff" stroke-width="3"/>
  <path d="M13 36h38M31 36v11" stroke="#fff" stroke-width="3"/>
  <rect x="36" y="40" width="10" height="3.5" fill="#8fdcff"/>
</svg>
{% else %}
<div class="masthead">
  <canvas class="masthead__canvas"></canvas>
  <div class="card">
    {% if person.avatar_src %}<img class="avatar" src="{{ person.avatar_src }}" alt="" />{% endif %}
    <h1 class="name display">{{ person.name }}</h1>
    <p class="role">{{ person.role }}</p>
    <p class="focus">{{ person.focus }}</p>
  </div>
  <p class="sections">Experience · Projects · Side Ventures · Résumé</p>
</div>
<script src="{{ arcs_url }}"></script>
{% endif %}
</body>
</html>

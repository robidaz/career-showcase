<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ person.name }} — {{ person.role }}</title>
  <meta name="description" content="{{ person.name }}, {{ person.role }}: {{ person.focus }}. Experience, projects, side ventures, and a downloadable one-page résumé." />
  <meta name="theme-color" content="#0f2550" />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content="{{ person.name }} — {{ person.role }}" />
  <meta property="og:description" content="{{ person.focus }}" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230f2550'/%3E%3Cpath d='M13 17h38v30H13z' fill='none' stroke='%23fff' stroke-width='3'/%3E%3Cpath d='M13 36h38M31 36v11' stroke='%23fff' stroke-width='3'/%3E%3Crect x='36' y='40' width='10' height='3.5' fill='%238fdcff'/%3E%3C/svg%3E" />
  <link rel="preload" href="{{ assets.font_archivo }}" as="font" type="font/woff2" crossorigin />
  <script>document.documentElement.classList.add("js");</script>
  <style>
    @font-face {
      font-family: "Archivo";
      src: url("{{ assets.font_archivo }}") format("woff2");
      font-weight: 100 900;
      font-stretch: 62% 125%;
      font-display: swap;
    }

    /* Holigram's wordmark face (brand guide: Roboto 800, -0.5px tracking) */
    @font-face {
      font-family: "Holigram Wordmark";
      src: url("{{ assets.font_roboto }}") format("woff2");
      font-weight: 800;
      font-display: swap;
    }

    :root {
      /* Drawing-set palette: cyanotype masthead, white sheets, navy ink */
      --blueprint: #0f2550;
      --blueprint-deep: #0a1a3a;
      --on-blue: #ffffff;
      --on-blue-soft: #dde8fb;
      --line-on-blue: rgba(255, 255, 255, 0.42);
      --grid-on-blue: rgba(255, 255, 255, 0.06);
      --grid-on-blue-major: rgba(255, 255, 255, 0.11);

      --paper: #eef2f8;
      --sheet: #ffffff;
      --ink: #0a1a33;
      --ink-2: #3d4d6a;
      --ink-3: #56657f;
      --rule: #d3dbe7;
      --rule-strong: #9fb0c9;

      --cobalt: #1f4fd1;
      --cobalt-ink: #173ea6;
      --cobalt-wash: #e4ecff;
      --hivis: #8fdcff;            /* ice cyan, matches the masthead needle */
      --hivis-ink: #0a1a33;

      /* Type scale: every font-size on the page uses one of these */
      --fs-xs: 0.8125rem;   /* 13px labels, chips, captions */
      --fs-sm: 0.875rem;    /* 14px secondary text */
      --fs-base: 1rem;      /* 16px body */
      --fs-md: 1.125rem;    /* 18px emphasis, card titles */
      --fs-lg: 1.375rem;    /* 22px lead text, sub-headings */
      --fs-xl: 1.75rem;     /* 28px headings */
      --fs-2xl: 2rem;       /* 32px section titles */

      --sans: "Archivo", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      --shadow-sheet: 0 1px 0 rgba(10, 26, 51, 0.04), 0 18px 32px -24px rgba(10, 26, 51, 0.45);
      --radius-sheet: 10px;
      --radius-control: 6px;
      --wrap: 1180px;
      --gutter: 24px;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html { -webkit-text-size-adjust: 100%; scroll-padding-top: 72px; }

    body {
      margin: 0;
      font-family: var(--sans);
      font-size: var(--fs-base);
      line-height: 1.62;
      color: var(--ink);
      background: var(--paper);
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; display: block; }
    a { color: var(--cobalt); text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
    a:hover { color: var(--cobalt-ink); }
    p { margin: 0 0 0.9em; }
    p:last-child { margin-bottom: 0; }
    h1, h2, h3, h4 { margin: 0; }
    ul { margin: 0; padding: 0; }

    :focus-visible { outline: 3px solid var(--cobalt); outline-offset: 2px; border-radius: 2px; }

    .wrap { width: 100%; max-width: calc(var(--wrap) + var(--gutter) * 2); margin: 0 auto; padding-inline: var(--gutter); }

    .skip-link {
      position: absolute; left: 12px; top: -48px; z-index: 50;
      padding: 10px 14px; border-radius: var(--radius-control);
      background: var(--hivis); color: var(--hivis-ink); font-weight: 600; text-decoration: none;
    }
    .skip-link:focus { top: 12px; }

    .visually-hidden {
      position: absolute !important; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
    }

    /* Display type: condensed Archivo carries the drawing-set voice */
    .display {
      font-family: var(--sans);
      font-stretch: 75%;
      font-weight: 740;
      letter-spacing: -0.005em;
      line-height: 1.04;
    }

    /* ── Buttons ─────────────────────────────────────────────── */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      min-height: 42px; padding: 9px 16px;
      border: 1.5px solid transparent; border-radius: var(--radius-control);
      font: inherit; font-weight: 600; font-stretch: 88%; font-size: var(--fs-base); line-height: 1.1;
      text-decoration: none; cursor: pointer;
      transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
    }
    .btn svg { width: 16px; height: 16px; flex: none; }
    .btn--hivis { background: var(--hivis); color: var(--hivis-ink); }
    .btn--hivis:hover { background: #c2ecff; color: var(--hivis-ink); }
    .btn--cobalt { background: var(--cobalt); color: #fff; }
    .btn--cobalt:hover { background: var(--cobalt-ink); color: #fff; }
    .btn--line { border-color: var(--rule-strong); color: var(--ink); background: var(--sheet); }
    .btn--line:hover { border-color: var(--cobalt); color: var(--cobalt-ink); }
    .btn--on-blue { border-color: var(--line-on-blue); color: var(--on-blue); background: transparent; }
    .btn--on-blue:hover { border-color: #fff; background: rgba(255, 255, 255, 0.08); color: #fff; }

    /* ── Masthead: the title block ───────────────────────────── */
    .masthead {
      color: var(--on-blue);
      background-color: var(--blueprint);
      background-image:
        linear-gradient(var(--grid-on-blue-major) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-on-blue-major) 1px, transparent 1px),
        linear-gradient(var(--grid-on-blue) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid-on-blue) 1px, transparent 1px),
        linear-gradient(180deg, var(--blueprint) 0%, var(--blueprint-deep) 100%);
      background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px, 100% 100%;
      background-position: -1px -1px;
      padding: 40px 0 28px;
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }
    /* With JS, slowly turning instrument arcs replace the grid (assets/js/masthead-arcs.js) */
    .js .masthead {
      background-image: linear-gradient(180deg, var(--blueprint) 0%, var(--blueprint-deep) 100%);
      background-size: auto;
    }
    .masthead__canvas { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; }
    .masthead > .wrap { position: relative; }

    .masthead :focus-visible, .sheet-tabs :focus-visible { outline-color: #fff; }

    .titleblock {
      background: rgba(5, 16, 40, 0.45);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(260px, 330px);
      grid-template-areas: "main resume cells";
      border: 1px solid var(--line-on-blue);
    }

    /* portrait and name share one panel */
    .titleblock__main { grid-area: main; display: flex; align-items: center; gap: 28px; padding: 24px 28px; min-width: 0; }
    .titleblock__avatar {
      flex: none; width: 112px; height: 112px; border-radius: 50%; object-fit: cover;
      box-shadow: 0 0 0 3px var(--blueprint), 0 0 0 4px var(--line-on-blue);
    }
    .titleblock__id { display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 0; }
    .titleblock__name { font-size: clamp(2.6rem, 5.4vw, 4.25rem); color: #fff; }
    .titleblock__role { margin: 4px 0 0; font-size: var(--fs-lg); font-weight: 600; font-stretch: 88%; line-height: 1.2; }
    .titleblock__focus { margin: 0; color: var(--on-blue-soft); font-size: var(--fs-base); }
    .titleblock__edu { margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--line-on-blue); color: var(--on-blue-soft); font-size: var(--fs-sm); }
    .titleblock__edu strong { color: #fff; font-weight: 600; }
    .titleblock__resume { grid-area: resume; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; padding: 16px 22px 12px; border-left: 1px solid var(--line-on-blue); }
    .resume-thumb {
      display: block; width: 168px; padding: 0; cursor: zoom-in; background: #fff;
      border: 0; border-radius: 3px; box-shadow: 0 0 0 1px var(--line-on-blue), 0 8px 18px -8px rgba(0, 0, 0, 0.6);
      transition: transform 160ms ease, box-shadow 160ms ease;
    }
    .resume-thumb img { display: block; width: 100%; height: auto; border-radius: 3px; }
    .resume-thumb:hover { transform: translateY(-2px); box-shadow: 0 0 0 2px var(--hivis), 0 12px 22px -8px rgba(0, 0, 0, 0.6); }
    .titleblock__resume-label { font-size: var(--fs-xs); color: var(--on-blue-soft); font-stretch: 88%; }

    .titleblock__cells { grid-area: cells; margin: 0; display: grid; grid-template-rows: repeat(4, 1fr); border-left: 1px solid var(--line-on-blue); }
    .titleblock__cell { padding: 10px 16px; display: flex; flex-direction: column; justify-content: center; min-width: 0; }
    .titleblock__cell + .titleblock__cell { border-top: 1px solid var(--line-on-blue); }
    .titleblock__cell dt { font-size: var(--fs-xs); color: var(--on-blue-soft); font-stretch: 88%; }
    .titleblock__cell dd { margin: 0; font-size: var(--fs-base); font-weight: 600; overflow-wrap: anywhere; }
    .titleblock__cell a { color: #fff; text-decoration: none; }
    .titleblock__cell a:hover { text-decoration: underline; color: #fff; }

    /* ── Sheet tabs (sticky) ─────────────────────────────────── */
    .sheet-tabs {
      position: sticky; top: 0; z-index: 30;
      background: var(--blueprint-deep);
      box-shadow: 0 1px 0 rgba(10, 26, 51, 0.12);
    }
    .sheet-tabs__list { display: flex; gap: 4px; padding-top: 8px; }

    .sheet-tab {
      appearance: none; flex: none; cursor: pointer;
      padding: 11px 18px 12px;
      border: 0; border-top: 3px solid transparent; border-radius: 8px 8px 0 0;
      background: transparent; color: #dbe6fb;
      font: inherit; font-size: var(--fs-base); font-weight: 600; font-stretch: 88%; line-height: 1.2;
      transition: background-color 140ms ease, color 140ms ease;
    }
    .sheet-tab:hover { color: #fff; background: rgba(255, 255, 255, 0.08); }
    .sheet-tab[aria-selected="true"] { background: var(--paper); color: var(--ink); border-top-color: var(--hivis); }
    .sheet-tab:focus-visible { outline-offset: -3px; }
    .sheet-tab[aria-selected="true"]:focus-visible { outline-color: var(--cobalt); }
    /* Work ▾ opens a small menu of its three sections */
    .tab-dd { position: relative; display: flex; flex: none; }
    .sheet-tab--menu { display: inline-flex; align-items: center; gap: 7px; }
    .caret { width: 11px; height: 11px; transition: transform 180ms ease; }
    .sheet-tab--menu[aria-expanded="true"] .caret { transform: rotate(180deg); }
    .tab-menu {
      position: absolute; top: 100%; left: 0; z-index: 40; min-width: 200px; margin-top: 6px; padding: 6px;
      display: grid; gap: 2px;
      background: var(--sheet); border: 1px solid var(--rule); border-radius: 10px;
      box-shadow: 0 18px 36px -18px rgba(10, 26, 51, 0.5);
    }
    .tab-menu[hidden] { display: none; }
    .tab-menu__item {
      appearance: none; cursor: pointer; text-align: left; padding: 9px 12px;
      border: 0; border-radius: 6px; background: transparent; color: var(--ink);
      font: inherit; font-size: var(--fs-base); font-weight: 600; font-stretch: 88%; line-height: 1.2;
    }
    .tab-menu__item:hover { background: var(--cobalt-wash); }
    .tab-menu__item[aria-pressed="true"] { color: var(--cobalt-ink); background: var(--cobalt-wash); box-shadow: inset 3px 0 0 var(--cobalt); }
    .tab-menu__item:focus-visible { outline: 2px solid var(--cobalt); outline-offset: 1px; }
    .js .subpanel:not(.is-active) { display: none; }
    .js .block.subpanel { margin-top: 0; padding-top: 0; border-top: 0; }

    .lbl-short { display: none; }
    @media (max-width: 480px) {
      .lbl-long { display: none; }
      .lbl-short { display: inline; }
    }

    /* ── Panels & blocks ─────────────────────────────────────── */
    .content { padding-top: 40px; padding-bottom: 72px; }

    .js .panel:not(.is-active) { display: none; }
    .panel.is-active { animation: panel-in 180ms ease-out; }
    @keyframes panel-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

    .block + .block { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--rule); }
    .block__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 20px; margin-bottom: 20px; }
    .block__title { font-size: var(--fs-2xl); }
    .block__note { margin: 0; color: var(--ink-3); font-size: var(--fs-sm); }
    .subhead { font-size: var(--fs-lg); margin-bottom: 12px; }

    .sheet {
      background: var(--sheet);
      border: 1px solid var(--rule);
      border-radius: var(--radius-sheet);
      box-shadow: var(--shadow-sheet);
    }

    .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
    .tags li {
      padding: 3px 9px; border-radius: 999px;
      background: var(--cobalt-wash); color: var(--cobalt-ink);
      font-size: var(--fs-xs); font-weight: 600; font-stretch: 88%; line-height: 1.4;
    }

    /* Accordions: native <details>, styled once */
    details > summary { list-style: none; cursor: pointer; }
    details > summary::-webkit-details-marker { display: none; }
    .chev {
      flex: none; width: 22px; height: 22px; border-radius: 50%;
      display: grid; place-items: center;
      border: 1.5px solid var(--rule-strong); color: var(--ink-2);
      transition: transform 180ms ease, border-color 140ms ease, color 140ms ease;
    }
    .chev::before {
      content: ""; width: 7px; height: 7px; margin-top: -3px;
      border-right: 1.75px solid currentColor; border-bottom: 1.75px solid currentColor;
      transform: rotate(45deg);
    }
    details[open] > summary .chev { transform: rotate(180deg); }
    details > summary:hover .chev { border-color: var(--cobalt); color: var(--cobalt); }

    @supports (interpolate-size: allow-keywords) {
      :root { interpolate-size: allow-keywords; }
      details::details-content {
        block-size: 0; overflow-y: clip;
        transition: block-size 220ms ease, content-visibility 220ms allow-discrete;
      }
      details[open]::details-content { block-size: auto; }
    }

    /* ── Tab 1: Profile ──────────────────────────────────────── */
    .profile-grid { max-width: 46rem; }

    /* Profile: one text style for the summary */
    .profile-text { font-size: var(--fs-base); line-height: 1.7; color: var(--ink); }




    /* ── Tab 2: Work & Projects ──────────────────────────────── */
    /* Experience as a dimension chain: segment widths are real durations */
    .dimchain { display: flex; align-items: stretch; margin: 6px 0 28px; }
    .dimchain__seg {
      appearance: none; cursor: pointer; position: relative;
      flex: var(--span) 1 0; min-width: 76px;
      padding: 0 8px 26px; border: 0; background: none; color: var(--ink-2);
      font: inherit; text-align: center;
      border-left: 1px solid var(--rule-strong);
    }
    .dimchain__seg.is-last { border-right: 1px solid var(--rule-strong); }
    .dimchain__label {
      display: block; padding: 8px 4px 10px;
      font-size: var(--fs-base); font-weight: 600; font-stretch: 88%; line-height: 1.15; white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
    }
    /* the dimension line with arrowheads */
    .dimchain__line {
      position: relative; display: block; height: 2px; margin: 0 2px;
      background: currentColor; color: var(--rule-strong);
    }
    .dimchain__line::before, .dimchain__line::after {
      content: ""; position: absolute; top: 50%; width: 0; height: 0;
      border-block: 5px solid transparent; transform: translateY(-50%);
    }
    .dimchain__line::before { left: -2px; border-right: 9px solid currentColor; }
    .dimchain__line::after { right: -2px; border-left: 9px solid currentColor; }
    .dimchain__year {
      position: absolute; bottom: 0; left: 0; transform: translateX(-50%);
      font-size: var(--fs-xs); font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums;
      padding: 0 4px; background: var(--paper);   /* breaks the tick line behind the label */
    }
    .dimchain__year--end { left: auto; right: 6px; transform: none; }
    /* the first label, and labels beside a break, sit inside their own span so they never collide */
    .dimchain__seg.is-first .dimchain__year:not(.dimchain__year--end),
    .dimchain__seg.is-after-gap .dimchain__year:not(.dimchain__year--end) { left: 6px; transform: none; }
    .dimchain__seg:hover { color: var(--ink); }
    .dimchain__seg:hover .dimchain__line { color: var(--cobalt); }
    .dimchain__seg[aria-selected="true"] { color: var(--ink); background: linear-gradient(180deg, var(--cobalt-wash), transparent 85%); }
    .dimchain__seg[aria-selected="true"] .dimchain__line { color: var(--cobalt); height: 3px; }
    .dimchain__seg[aria-selected="true"] .dimchain__label { font-weight: 740; }
    .dimchain__gap { flex: 0 0 38px; display: grid; place-items: start center; padding-top: 30px; color: var(--rule-strong); }
    .dimchain__gap svg { width: 30px; height: 16px; }
    .dimchain__years-mobile { display: none; }

    .js .role:not(.is-active) { display: none; }
    .role { max-width: 80ch; }
    .role + .role { margin-top: 28px; }
    .js .role + .role { margin-top: 0; }
    .role__title { font-size: var(--fs-xl); }
    .role__meta { margin: 6px 0 14px; color: var(--ink-2); }
    .role__meta strong { color: var(--ink); font-weight: 600; }
    .role__bullets { list-style: none; display: grid; gap: 10px; }
    .role__bullets li { position: relative; padding-left: 22px; }
    .role__bullets li::before {
      content: ""; position: absolute; left: 2px; top: 0.62em;
      width: 9px; height: 2px; background: var(--cobalt);
    }

    .feature {
      display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 24px 36px;
      padding: 28px 30px; border-top: 4px solid var(--blueprint);
    }
    .feature__aside { display: flex; flex-direction: column; gap: 18px; padding-left: 30px; border-left: 1px solid var(--rule); }
    .feature__built h4 { font-size: var(--fs-sm); font-weight: 600; font-stretch: 88%; color: var(--ink-3); margin-bottom: 4px; }
    .feature__built p { font-size: var(--fs-base); color: var(--ink-2); }
    .feature__status {
      display: inline-flex; align-items: center; gap: 8px; margin-bottom: 12px;
      padding: 5px 10px; border: 1.5px solid var(--cobalt); border-radius: var(--radius-control);
      color: var(--cobalt-ink); font-size: var(--fs-sm); font-weight: 600; font-stretch: 88%;
    }
    .feature__status svg { width: 15px; height: 15px; }
    .feature__title { font-size: var(--fs-2xl); margin-bottom: 18px; }
    .spec { margin: 0; display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px 20px; }
    .spec dt { font-size: var(--fs-sm); font-weight: 600; font-stretch: 88%; color: var(--ink-3); padding-top: 2px; }
    .spec dd { margin: 0; max-width: 72ch; }
    .feature .spec dd { color: var(--ink); }
    /* Dashed outline = planned work, like phantom lines on a drawing */
    .feature__next {
      padding: 16px 18px;
      border: 1.5px dashed var(--cobalt); border-radius: 8px; background: #f7f9ff;
    }
    .feature__next h4 { font-size: var(--fs-md); margin-bottom: 6px; color: var(--cobalt-ink); }
    .feature__next p { color: var(--ink); font-size: var(--fs-base); }

    .projects { margin-top: 28px; border-top: 1px solid var(--rule); }
    .project { border-bottom: 1px solid var(--rule); }
    .project > summary {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 20px;
      padding: 16px 4px;
    }
    .project__title { font-size: var(--fs-lg); display: block; }
    .project__impact { display: block; color: var(--ink-2); font-size: var(--fs-base); margin-top: 3px; }
    .project > summary:hover .project__title { color: var(--cobalt-ink); }
    .project__body { padding: 2px 4px 22px; }
    .project__body .tags { margin-top: 16px; }

    .skills { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); background: var(--sheet); border-radius: var(--radius-sheet); overflow: hidden; }
    .skills__group { padding: 20px 22px 22px; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
    .skills__name { font-size: var(--fs-md); margin-bottom: 12px; }
    .skills__list { list-style: none; display: grid; gap: 9px; }
    .skill { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 12px; }
    .skill__name { font-size: var(--fs-sm); line-height: 1.3; }
    .meter { display: inline-flex; gap: 3px; }
    .meter i { width: 14px; height: 7px; border-radius: 1.5px; background: var(--rule); }
    .meter i.is-on { background: var(--cobalt); }
    .legend { margin: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--ink-3); font-size: var(--fs-sm); }
    .legend span { display: inline-flex; align-items: center; gap: 8px; }

    /* ── Tab 3: Side Ventures ────────────────────────────────── */
    .ventures-intro { max-width: 62ch; color: var(--ink-2); font-size: var(--fs-md); margin-bottom: 28px; }
    .ventures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; align-items: start; }

    .venture { overflow: hidden; display: flex; flex-direction: column; }
    .venture__brand { display: flex; align-items: center; gap: 18px; padding: 26px 26px 24px; }
    .venture__logo { flex: none; width: 76px; height: 76px; object-fit: contain; }
    .venture__name { font-size: var(--fs-xl); line-height: 1.05; }
    .venture__tagline { margin: 6px 0 0; font-size: var(--fs-base); line-height: 1.4; }
    .venture__body { padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 14px; }
    .venture__role { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; color: var(--ink-2); }
    .venture__role strong { color: var(--ink); font-weight: 700; font-size: var(--fs-base); }
    .venture__status { padding: 2px 9px; border-radius: 999px; font-size: var(--fs-xs); font-weight: 600; font-stretch: 88%; }
    .venture__summary { margin: 0; }
    .venture__highlights { list-style: none; display: grid; gap: 8px; }
    .venture__highlights li { position: relative; padding-left: 20px; color: var(--ink-2); }
    .venture__highlights li::before { content: ""; position: absolute; left: 2px; top: 0.62em; width: 8px; height: 2px; }
    .venture__cta { align-self: flex-start; margin-top: 4px; }

    /* Holigram: dark-first brand — the mark is never shown on white */
    .venture--holigram .venture__brand {
      background:
        radial-gradient(120% 140% at 0% 0%, rgba(40, 194, 242, 0.28), transparent 55%),
        radial-gradient(90% 120% at 100% 100%, rgba(45, 108, 240, 0.30), transparent 60%),
        #050b18;
      color: #e8f3ff;
    }
    .venture--holigram .venture__logo { filter: drop-shadow(0 0 18px rgba(40, 194, 242, 0.45)); }
    .venture--holigram .venture__name { font-family: "Holigram Wordmark", Roboto, "Helvetica Neue", Arial, sans-serif; font-weight: 800; font-stretch: 100%; letter-spacing: -0.5px; }
    .venture--holigram .venture__tagline { color: #8fa8c8; }
    .venture--holigram .venture__status { background: #e0f6fd; color: #04506b; }
    .venture--holigram .venture__highlights li::before { background: #28c2f2; }
    .venture--holigram .venture__cta { background: #28c2f2; color: #050b18; }
    .venture--holigram .venture__cta:hover { background: #5fd8ff; color: #050b18; }

    /* Hourglass Trader: black and gold */
    .venture--hourglass .venture__brand {
      background:
        radial-gradient(110% 130% at 100% 0%, rgba(215, 180, 90, 0.20), transparent 55%),
        #050604;
      color: #f4f3ec;
      border-bottom: 3px solid #d4af37;
    }
    .venture--hourglass .venture__logo { background: #fff; border-radius: 14px; padding: 4px; }
    .venture--hourglass .venture__name { color: #d7b45a; }
    .venture--hourglass .venture__tagline { color: #d9d9d0; }
    .venture--hourglass .venture__highlights li::before { background: #c49b30; }
    .venture--hourglass .venture__cta { background: #d4af37; color: #050604; }
    .venture--hourglass .venture__cta:hover { background: #f0d060; color: #050604; }

    /* ── Tab 4: About Me ─────────────────────────────────────── */
    .awards { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; border-top: 1px solid var(--rule); }
    .award { display: grid; grid-template-columns: 32px minmax(0, 1fr); align-content: start; gap: 2px 12px; padding: 14px 2px; border-bottom: 1px solid var(--rule); }
    .award__icon { grid-row: span 2; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--cobalt-wash); color: var(--cobalt-ink); }
    .award__icon svg { width: 17px; height: 17px; }
    .award__title { font-weight: 700; line-height: 1.3; }
    .award__detail { color: var(--ink-2); font-size: var(--fs-sm); }

    .types { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 30px; }
    .type { padding: 16px 18px 18px; background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius-sheet); }
    .type__result { font-size: var(--fs-lg); }
    .type__system { margin: 2px 0 8px; color: var(--cobalt-ink); font-size: var(--fs-sm); font-weight: 600; font-stretch: 88%; }
    .type__body { color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.55; }

    .traits { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 40px; }
    .traits dt { font-weight: 700; }
    .traits dd { margin: 4px 0 0; color: var(--ink-2); max-width: 60ch; }

    .about-life { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 48px; align-items: start; }
    .hobbies { list-style: none; display: grid; gap: 18px; }
    .hobby__name { font-weight: 700; }
    .hobby__items { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 7px; }
    .hobby__items li { padding: 3px 10px; border: 1px solid var(--rule-strong); border-radius: 999px; font-size: var(--fs-sm); color: var(--ink-2); background: var(--sheet); }
    .hobby__text { margin-top: 4px; color: var(--ink-2); }

    .books {
      list-style: none; max-height: 340px; overflow-y: auto; overscroll-behavior: contain;
      background: var(--sheet); border: 1px solid var(--rule); border-radius: var(--radius-sheet);
      scrollbar-width: thin; scrollbar-color: var(--rule-strong) transparent;
    }
    .books:focus-visible { outline-offset: 2px; }
    .book { padding: 10px 14px; }
    .book + .book { border-top: 1px solid var(--rule); }
    .book__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; }
    .book__title { font-weight: 600; font-size: var(--fs-sm); line-height: 1.35; }
    .book__author { color: var(--ink-3); font-size: var(--fs-xs); }
    .book__insight { margin: 2px 0 0; color: var(--ink-2); font-size: var(--fs-sm); line-height: 1.45; }

    /* ── Résumé viewer dialog (behavior in assets/js/resume-viewer.js) ── */
    .resume-dialog {
      width: min(1000px, 94vw); height: 92vh; max-width: none; max-height: none;
      padding: 0; border: 1px solid var(--rule); border-radius: 12px;
      background: var(--sheet); color: var(--ink);
      box-shadow: 0 30px 80px -30px rgba(6, 20, 48, 0.6);
    }
    .resume-dialog[open] { display: flex; flex-direction: column; }
    body:has(.resume-dialog[open]) { overflow: hidden; }
    .resume-dialog::backdrop { background: rgba(6, 20, 48, 0.62); }
    .resume-dialog__bar { display: flex; align-items: center; gap: 10px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--rule); }
    .resume-dialog__bar h2 { margin-right: auto; font-size: var(--fs-lg); font-stretch: 75%; font-weight: 740; }
    .resume-dialog__download {
      display: inline-flex; align-items: center; min-height: 38px; padding: 7px 14px;
      border-radius: var(--radius-control); background: var(--cobalt); color: #fff;
      font-weight: 600; font-stretch: 88%; font-size: var(--fs-sm); text-decoration: none;
    }
    .resume-dialog__download:hover { background: var(--cobalt-ink); color: #fff; }
    .resume-dialog__close {
      width: 38px; height: 38px; border: 1.5px solid var(--rule-strong); border-radius: var(--radius-control);
      background: var(--sheet); color: var(--ink); font-size: var(--fs-lg); line-height: 1; cursor: pointer;
    }
    .resume-dialog__close:hover { border-color: var(--cobalt); color: var(--cobalt); }
    .resume-dialog__viewer { flex: 1; min-height: 0; position: relative; background: var(--paper); }

    /* ── Responsive ──────────────────────────────────────────── */
    @media (max-width: 1080px) {
      .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .ventures { grid-template-columns: 1fr; max-width: 720px; }
    }

    @media (max-width: 860px) {
      .titleblock { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "main resume" "cells cells"; }
      .titleblock__avatar { width: 88px; height: 88px; }
      .titleblock__main { gap: 20px; padding: 20px 22px; }
      .resume-thumb { width: 124px; }
      .titleblock__cells { grid-template-rows: none; grid-template-columns: repeat(2, minmax(0, 1fr)); border-left: 0; border-top: 1px solid var(--line-on-blue); }
      .titleblock__cell + .titleblock__cell { border-top: 0; }
      .titleblock__cell:nth-child(even) { border-left: 1px solid var(--line-on-blue); }
      .titleblock__cell:nth-child(n + 3) { border-top: 1px solid var(--line-on-blue); }
      .feature { grid-template-columns: 1fr; }
      .traits, .about-life { grid-template-columns: 1fr; }
      .about-life { gap: 36px; }
      .feature__aside { padding: 20px 0 0; border-left: 0; border-top: 1px solid var(--rule); }
    }

    @media (max-width: 640px) {
      :root { --gutter: 16px; }
      .masthead { padding: 16px 0 16px; }
      .titleblock { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "main resume" "cells cells"; }
      .titleblock__main { flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 8px 16px 16px; }
      .titleblock__avatar { width: 64px; height: 64px; }
      .titleblock__id { gap: 2px; }
      .titleblock__name { font-size: var(--fs-2xl); }
      .titleblock__role { font-size: var(--fs-md); }
      .titleblock__focus { font-size: var(--fs-sm); line-height: 1.4; }
      .titleblock__resume { padding: 16px 16px 12px 4px; border-left: 0; justify-content: flex-start; }
      .resume-thumb { width: 96px; }
      .titleblock__cells { grid-template-columns: 1fr; }
      .titleblock__cell { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 12px; padding: 8px 16px; }
      .titleblock__cell dd { text-align: right; }
      .titleblock__cell:nth-child(even) { border-left: 0; }
      .titleblock__cell + .titleblock__cell { border-top: 1px solid var(--line-on-blue); }
      .sheet-tab { padding: 10px 14px 11px; font-size: var(--fs-base); }
      .content { padding-top: 28px; }
      .block__title { font-size: var(--fs-xl); }
      .dimchain { flex-direction: column; margin-bottom: 20px; border-left: 2px solid var(--rule-strong); }
      .dimchain__seg { flex: none; min-width: 0; display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: center; padding: 10px 12px; text-align: left; border-left: 0; }
      .dimchain__seg.is-last { border-right: 0; }
      .dimchain__label { grid-column: 2; grid-row: 1; padding: 0; }
      .dimchain__line { display: none; }
      .dimchain__year { position: static; transform: none; grid-column: 1; grid-row: 1; font-size: var(--fs-sm); }
      .dimchain__year--end { display: none; }
      .dimchain__years-mobile { display: inline; }
      .dimchain__seg[aria-selected="true"] { background: var(--cobalt-wash); box-shadow: inset 3px 0 0 var(--cobalt); }
      .dimchain__gap { display: none; }
      .feature { padding: 22px 18px; }
      .feature__title { font-size: var(--fs-xl); }
      .spec { grid-template-columns: 1fr; gap: 2px; }
      .spec dd + dt { margin-top: 12px; }
      .skills { grid-template-columns: 1fr; }
      .types { grid-template-columns: 1fr; gap: 10px; }
      .awards { grid-template-columns: 1fr; }
      .venture__brand { padding: 20px; gap: 14px; }
      .venture__logo { width: 60px; height: 60px; }
      .venture__name { font-size: var(--fs-xl); }
      .venture__body { padding: 18px 20px 22px; }
      .resume-dialog { width: 100vw; height: 100dvh; border-radius: 0; border: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
    }

    @media print {
      .sheet-tabs, .skip-link, .masthead__canvas, .titleblock__resume, .resume-dialog { display: none !important; }
      .js .panel:not(.is-active), .js .role:not(.is-active) { display: block; }
      details > *:not(summary) { display: block; }
      .masthead { background: none; color: var(--ink); padding: 0 0 16px; }
      .titleblock, .titleblock > * + * { border-color: var(--rule-strong); }
      .titleblock__name, .titleblock__cell a { color: var(--ink); }
      .titleblock__focus, .titleblock__cell dt { color: var(--ink-3); }
    }
  </style>
</head>
<body>
  {% macro external_icon() -%}
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2.5h4v4M13.5 2.5 7 9M11.5 9.5v3a1 1 0 0 1-1 1h-7a1 1 0 0 1-1-1v-7a1 1 0 0 1 1-1h3"/></svg>
  {%- endmacro %}
  {% macro download_icon() -%}
  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v7.5M4.75 7 8 10.25 11.25 7M3 13.5h10"/></svg>
  {%- endmacro %}

  <a class="skip-link" href="#content">Skip to content</a>

  <!-- ══ Masthead: title block ═══════════════════════════════════ -->
  <header class="masthead">
    <canvas class="masthead__canvas" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="titleblock">
        <div class="titleblock__main">
          <img class="titleblock__avatar" src="{{ person.avatar_src }}" alt="Portrait of {{ person.name }}" width="112" height="112" />
          <div class="titleblock__id">
            <h1 class="titleblock__name display">{{ person.name }}</h1>
            <p class="titleblock__role">{{ person.role }}</p>
            <p class="titleblock__focus">{{ person.focus }}</p>
{% if education %}
            {% set edu = education[0] %}
            <p class="titleblock__edu"><strong>{{ edu.degree }}</strong>, {{ edu.school.split(' — ')[0] }}</p>
            {% endif %}
          </div>
        </div>
        {% if assets.resume_pdf %}
        <div class="titleblock__resume">
          <button type="button" class="resume-thumb" data-resume-open aria-label="View résumé">
            <img src="{{ assets.resume_thumb or assets.resume_preview }}" alt="" width="336" height="435" />
          </button>
          <span class="titleblock__resume-label" aria-hidden="true">Résumé</span>
        </div>
        {% endif %}
        <dl class="titleblock__cells">
          <div class="titleblock__cell"><dt>Based in</dt><dd>{{ person.location }}</dd></div>
          <div class="titleblock__cell"><dt>Email</dt><dd><a href="mailto:{{ person.email }}">{{ person.email }}</a></dd></div>
          <div class="titleblock__cell"><dt>Phone</dt><dd><a href="tel:{{ person.phone_href }}">{{ person.phone }}</a></dd></div>
          <div class="titleblock__cell"><dt>LinkedIn</dt><dd><a href="{{ person.linkedin }}" target="_blank" rel="noopener">{{ person.linkedin_display }}</a></dd></div>
        </dl>
      </div>
    </div>
  </header>

  <nav class="sheet-tabs" aria-label="Sections">
    <div class="wrap">
      <div class="sheet-tabs__list" role="tablist">
        {% for tab in tabs %}
        {% if tab.id == 'work' %}
        <div class="tab-dd" role="presentation">
          <button type="button" class="sheet-tab sheet-tab--menu" role="tab" id="tab-work" data-tab="work"
                  aria-controls="panel-work" aria-selected="false" tabindex="-1" aria-haspopup="true" aria-expanded="false"><span class="lbl-long">{{ tab.label }}</span><span class="lbl-short">{{ tab.short }}</span><svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4h8L6 9z" fill="currentColor"/></svg></button>
          <div class="tab-menu" id="work-menu" role="group" aria-label="Work sections" hidden>
            <button type="button" class="tab-menu__item" data-sub="experience" aria-controls="sub-experience" aria-pressed="true">Experience</button>
            <button type="button" class="tab-menu__item" data-sub="projects" aria-controls="sub-projects" aria-pressed="false">Projects</button>
            <button type="button" class="tab-menu__item" data-sub="skills" aria-controls="sub-skills" aria-pressed="false">Skills</button>
          </div>
        </div>
        {% else %}
        <button type="button" class="sheet-tab" role="tab" id="tab-{{ tab.id }}" data-tab="{{ tab.id }}"
                aria-controls="panel-{{ tab.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}><span class="lbl-long">{{ tab.label }}</span><span class="lbl-short">{{ tab.short }}</span></button>
        {% endif %}
        {% endfor %}
      </div>
    </div>
  </nav>

  <main id="content" class="content wrap" tabindex="-1">

    <!-- ══ Tab 1 — Profile ═════════════════════════════════════ -->
    <section class="panel is-active" id="panel-profile" role="tabpanel" aria-labelledby="tab-profile">
      <div class="profile-grid">
        <div class="profile-main">
          <div class="block">
            <h2 class="visually-hidden">Professional summary</h2>
            {% for para in profile.summary.split('\n\n') %}
            <p class="profile-text">{{ para | links }}</p>
            {% endfor %}
          </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ══ Tab 2 — Work ════════════════════════════════════════ -->
    <section class="panel" id="panel-work" role="tabpanel" aria-labelledby="tab-work">

      <div class="block subpanel is-active" id="sub-experience" data-sub="experience">
        <div class="block__head">
          <h2 class="block__title display">Experience</h2>
          <p class="block__note">Select a role to read more.</p>
        </div>

        <div class="dimchain" role="tablist" aria-label="Roles by date">
          {% for seg in timeline %}
          {% if seg.kind == 'gap' %}
          <span class="dimchain__gap" aria-hidden="true" title="{{ seg.start }}–{{ seg.end }}">
            <svg viewBox="0 0 30 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M0 8h7l3-6 4 12 4-12 3 6h9"/></svg>
          </span>
          {% else %}
          {% set role = roles[seg.index] %}
          {% set next = timeline[loop.index] if not loop.last else none %}
          <button type="button" class="dimchain__seg{% if loop.last or (next and next.kind == 'gap') %} is-last{% endif %}{% if loop.first %} is-first{% endif %}{% if not loop.first and loop.previtem.kind == 'gap' %} is-after-gap{% endif %}" role="tab"
                  id="role-tab-{{ seg.index }}" data-role="{{ seg.index }}" aria-controls="role-{{ seg.index }}"
                  aria-selected="{{ 'true' if seg.index == 0 else 'false' }}"{% if seg.index != 0 %} tabindex="-1"{% endif %}
                  style="--span: {{ seg.span }}">
            <span class="dimchain__label">{{ role.short }}</span>
            <span class="dimchain__line" aria-hidden="true"></span>
            <span class="dimchain__year">{{ seg.start }}<span class="dimchain__years-mobile">–{{ seg.end_label }}</span></span>
            {% if loop.last or (next and next.kind == 'gap') %}<span class="dimchain__year dimchain__year--end" aria-hidden="true">{{ seg.end_label }}</span>{% endif %}
          </button>
          {% endif %}
          {% endfor %}
        </div>

        {% for role in roles %}
        <article class="role{% if loop.first %} is-active{% endif %}" id="role-{{ loop.index0 }}" role="tabpanel" aria-labelledby="role-tab-{{ loop.index0 }}">
          <h3 class="role__title display">{{ role.title }}</h3>
          <p class="role__meta"><strong>{{ role.company }}</strong>, {{ role.period }}</p>
          <ul class="role__bullets">
            {% for bullet in role.bullets %}
            <li>{{ bullet }}</li>
            {% endfor %}
          </ul>
        </article>
        {% endfor %}
      </div>

      <div class="block subpanel" id="sub-projects" data-sub="projects">
        <div class="block__head"><h2 class="block__title display">Projects</h2></div>

        {% for p in projects if p.featured %}
        <article class="feature sheet">
          <div class="feature__main">
            {% if p.status %}
            <p class="feature__status"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3.5 8.5 3 3 6-7"/></svg>{{ p.status }}</p>
            {% endif %}
            <h3 class="feature__title display">{{ p.title }}</h3>
            <dl class="spec">
              <dt>Problem</dt><dd>{{ p.problem }}</dd>
              <dt>Solution</dt><dd>{{ p.solution }}</dd>
              <dt>Impact</dt><dd>{{ p.impact }}</dd>
            </dl>
          </div>
          <div class="feature__aside">
            {% if p.next %}
            <div class="feature__next">
              <h4 class="display">What's next</h4>
              <p>{{ p.next }}</p>
            </div>
            {% endif %}
            <div class="feature__built">
              <h4>Built with</h4>
              <p>{{ p.tech }}</p>
            </div>
            <ul class="tags" aria-label="Tags">{% for tag in p.tags %}<li>{{ tag }}</li>{% endfor %}</ul>
          </div>
        </article>
        {% endfor %}

        <div class="projects">
          {% for p in projects if not p.featured %}
          <details class="project" name="projects">
            <summary>
              <span>
                <span class="project__title display">{{ p.title }}</span>
                <span class="project__impact">{{ p.impact_short }}</span>
              </span>
              <span class="chev" aria-hidden="true"></span>
            </summary>
            <div class="project__body">
              <dl class="spec">
                <dt>Problem</dt><dd>{{ p.problem }}</dd>
                <dt>Solution</dt><dd>{{ p.solution }}</dd>
                <dt>Impact</dt><dd>{{ p.impact }}</dd>
                <dt>Built with</dt><dd>{{ p.tech }}</dd>
              </dl>
              <ul class="tags" aria-label="Tags">{% for tag in p.tags %}<li>{{ tag }}</li>{% endfor %}</ul>
            </div>
          </details>
          {% endfor %}
        </div>
      </div>

      <div class="block subpanel" id="sub-skills" data-sub="skills">
        <div class="block__head">
          <h2 class="block__title display">Skills</h2>
          <p class="legend" aria-hidden="true">
            {% for level in ['Beginner', 'Intermediate', 'Advanced', 'Expert'] %}
            {% set filled = loop.index %}
            <span><span class="meter">{% for i in range(1, 5) %}<i{% if i <= filled %} class="is-on"{% endif %}></i>{% endfor %}</span>{{ level }}</span>
            {% endfor %}
          </p>
        </div>
        <div class="skills">
          {% for group in skills %}
          <section class="skills__group" aria-labelledby="skills-{{ loop.index }}">
            <h3 class="skills__name display" id="skills-{{ loop.index }}">{{ group.category }}</h3>
            <ul class="skills__list">
              {% for skill in group.skills %}
              <li class="skill">
                <span class="skill__name">{{ skill.name }}</span>
                <span class="meter" role="img" aria-label="{{ skill.level }}, {{ skill.level_index }} of 4" title="{{ skill.level }}">{% for i in range(1, 5) %}<i{% if i <= skill.level_index %} class="is-on"{% endif %}></i>{% endfor %}</span>
              </li>
              {% endfor %}
            </ul>
          </section>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ══ Tab 3 — Side Ventures ═══════════════════════════════ -->
    <section class="panel" id="panel-ventures" role="tabpanel" aria-labelledby="tab-ventures">
      <div class="block__head"><h2 class="block__title display">Side ventures</h2></div>
      <p class="ventures-intro">Products I build and teams I advise outside the day job.</p>
      <div class="ventures">
        {% for v in ventures %}
        <article class="venture venture--{{ v.theme }} sheet" aria-labelledby="venture-{{ loop.index }}">
          <header class="venture__brand">
            {% if v.logo %}<img class="venture__logo" src="{{ v.logo }}" alt="{{ v.name }} logo" width="76" height="76" loading="lazy" />{% endif %}
            <div>
              <h3 class="venture__name display" id="venture-{{ loop.index }}">{{ v.name }}</h3>
              {% if v.tagline %}<p class="venture__tagline">{{ v.tagline }}</p>{% endif %}
            </div>
          </header>
          <div class="venture__body">
            <p class="venture__role"><strong>{{ v.role }}</strong>{% if v.period %}<span>{{ v.period }}</span>{% endif %}{% if v.status %}<span class="venture__status">{{ v.status }}</span>{% endif %}</p>
            <p class="venture__summary">{{ v.summary }}</p>
            {% if v.highlights %}
            <ul class="venture__highlights">
              {% for item in v.highlights %}<li>{{ item }}</li>{% endfor %}
            </ul>
            {% endif %}
            {% if v.tags %}<ul class="tags" aria-label="Tags">{% for tag in v.tags %}<li>{{ tag }}</li>{% endfor %}</ul>{% endif %}
            <a class="btn venture__cta" href="{{ v.url }}" target="_blank" rel="noopener">Visit {{ v.url_display }}{{ external_icon() }}<span class="visually-hidden"> (opens in a new tab)</span></a>
          </div>
        </article>
        {% endfor %}
      </div>
    </section>

    <!-- ══ Tab 4 — About Me ════════════════════════════════════ -->
    <section class="panel" id="panel-about" role="tabpanel" aria-labelledby="tab-about">
      <section class="block" aria-labelledby="style-title">
        <div class="block__head"><h2 class="block__title display" id="style-title">How Zach works</h2></div>
        <ul class="types" aria-label="Personality assessments">
          {% for trait in about.personality if trait.group == 'test' %}
          <li class="type">
            <div class="type__result display">{{ trait.result }}</div>
            <div class="type__system">{{ trait.system }}</div>
            <p class="type__body">{{ trait.value }}</p>
          </li>
          {% endfor %}
        </ul>
        <dl class="traits">
          {% for trait in about.personality if trait.group == 'style' %}
          <div><dt>{{ trait.label }}</dt><dd>{{ trait.value }}</dd></div>
          {% endfor %}
        </dl>
      </section>

      {% if recognition %}
      <section class="block" aria-labelledby="recognition-title">
        <div class="block__head"><h2 class="block__title display" id="recognition-title">Recognition</h2></div>
        <ul class="awards">
          {% for a in recognition %}
          <li class="award">
            <span class="award__icon" aria-hidden="true"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><circle cx="10" cy="8" r="5"/><path d="m7 12.2-1.5 5.3L10 15.4l4.5 2.1-1.5-5.3"/></svg></span>
            <span class="award__title">{{ a.title }}</span>
            <span class="award__detail">{{ a.detail }}{% if a.issuer %} ({{ a.issuer }}){% endif %}</span>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      <div class="block about-life">
        <section aria-labelledby="interests-title">
          <h2 class="subhead display" id="interests-title">Outside work</h2>
          <ul class="hobbies">
            {% for hobby in about.hobbies if hobby['items'] or not about.books %}
            <li>
              <div class="hobby__name">{{ hobby.name }}</div>
              {% if hobby['items'] %}
              <ul class="hobby__items">{% for item in hobby['items'] %}<li>{{ item }}</li>{% endfor %}</ul>
              {% endif %}
            </li>
            {% endfor %}
            {% for trait in about.personality if trait.group == 'family' %}
            <li>
              <div class="hobby__name">{{ trait.label }}</div>
              <p class="hobby__text">{% for item in trait.sub_items %}{{ item.value }}{% if not loop.last %} {% endif %}{% endfor %}</p>
            </li>
            {% endfor %}
          </ul>
        </section>

        {% if about.books %}
        <section aria-labelledby="books-title">
          <h2 class="subhead display" id="books-title">Reading that shaped my thinking</h2>
          <ul class="books" tabindex="0" aria-label="Book list (scrollable)">
            {% for book in about.books %}
            <li class="book">
              <div class="book__head"><span class="book__title">{{ book.title }}</span>{% if book.author %}<span class="book__author">{{ book.author }}</span>{% endif %}</div>
              <p class="book__insight">{{ book.insight }}</p>
            </li>
            {% endfor %}
          </ul>
        </section>
        {% endif %}
      </div>
    </section>
  </main>

  {% if assets.resume_pdf %}
  <dialog id="resume-dialog" class="resume-dialog" aria-labelledby="resume-dialog-title"
          data-pdf-url="{{ assets.resume_pdf }}"
          data-preview-url="{{ assets.resume_preview }}"
          data-css-url="{{ assets.viewer_css }}"
          data-license-url="syncfusion-license.js">
    <div class="resume-dialog__bar">
      <h2 id="resume-dialog-title">Résumé</h2>
      <a class="resume-dialog__download" href="{{ assets.resume_pdf }}" download="{{ resume.file_name }}">Download PDF</a>
      <button type="button" class="resume-dialog__close" data-resume-close aria-label="Close résumé viewer">×</button>
    </div>
    <div id="resume-viewer" class="resume-dialog__viewer"></div>
  </dialog>
  <script src="{{ assets.viewer_js }}" defer></script>
  {% endif %}
  <script src="{{ assets.masthead_js }}" defer></script>

  <script>
    // Tabs: a roving-tabindex tablist with deep links (#work, #ventures, #about)
    (function () {
      function tablist(list, onSelect) {
        var tabs = Array.prototype.slice.call(list.querySelectorAll('[role="tab"]'));
        function select(tab, focus) {
          tabs.forEach(function (t) {
            var on = t === tab;
            t.setAttribute("aria-selected", on ? "true" : "false");
            t.tabIndex = on ? 0 : -1;
            var panel = document.getElementById(t.getAttribute("aria-controls"));
            if (panel) panel.classList.toggle("is-active", on);
          });
          if (focus) tab.focus();
          if (onSelect) onSelect(tab);
        }
        list.addEventListener("click", function (e) {
          var tab = e.target.closest('[role="tab"]');
          if (tab) select(tab, false);
        });
        list.addEventListener("keydown", function (e) {
          var i = tabs.indexOf(document.activeElement);
          if (i < 0) return;
          var next = { ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
          if (next === undefined) return;
          e.preventDefault();
          select(tabs[(next + tabs.length) % tabs.length], true);
        });
        return { tabs: tabs, select: select };
      }

      var nav = document.querySelector(".sheet-tabs");
      var masthead = document.querySelector(".masthead");
      var workTab = document.getElementById("tab-work");
      var menu = document.getElementById("work-menu");
      var subButtons = menu ? Array.prototype.slice.call(menu.querySelectorAll(".tab-menu__item")) : [];
      var currentSub = "experience";

      function setMenu(open) {
        if (!menu) return;
        menu.hidden = !open;
        workTab.setAttribute("aria-expanded", open ? "true" : "false");
      }

      function showSub(id) {
        currentSub = id;
        subButtons.forEach(function (b) {
          var on = b.dataset.sub === id;
          b.setAttribute("aria-pressed", on ? "true" : "false");
          var panel = document.getElementById(b.getAttribute("aria-controls"));
          if (panel) panel.classList.toggle("is-active", on);
        });
      }

      var sheets = tablist(nav.querySelector('[role="tablist"]'), function (tab) {
        var id = tab.dataset.tab;
        if (id !== "work") setMenu(false);
        var hash = id === "work" && currentSub !== "experience" ? currentSub : id;
        history.replaceState(null, "", id === "profile" ? location.pathname + location.search : "#" + hash);
        tab.scrollIntoView({ block: "nearest", inline: "nearest" });
        // Keep the new sheet's first line in view once the tab bar is stuck
        var top = masthead.offsetHeight;
        if (window.scrollY > top) window.scrollTo(0, top);
      });

      if (menu) {
        // clicking anywhere on Work opens (or closes) its menu; the tablist also selects the tab
        workTab.addEventListener("click", function () { setMenu(menu.hidden); });
        subButtons.forEach(function (b) {
          b.addEventListener("click", function () {
            showSub(b.dataset.sub);
            sheets.select(workTab, false);
            setMenu(false);
            workTab.focus();
          });
        });
        document.addEventListener("click", function (e) {
          if (!menu.hidden && !e.target.closest(".tab-dd")) setMenu(false);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !menu.hidden) { setMenu(false); workTab.focus(); }
        });
      }

      function fromHash() {
        var id = location.hash.slice(1);
        if (id === "experience" || id === "projects" || id === "skills") { showSub(id); id = "work"; }
        var tab = sheets.tabs.filter(function (t) { return t.dataset.tab === id; })[0];
        if (tab) sheets.select(tab, false);
      }
      fromHash();
      window.addEventListener("hashchange", fromHash);

      var chain = document.querySelector(".dimchain");
      if (chain) tablist(chain);
    })();
  </script>
</body>
</html>
